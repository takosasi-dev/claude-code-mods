{
  "name": "focus-timer",
  "version": "0.2.1",
  "description": "/focus でポモドーロのタイマーをペインに SVG のリングで表示し、今日の完了本数を残す",
  "author": { "name": "takosasi-dev" },
  "types": "./types/index.d.ts",
  "userConfig": {
    "focusMinutes": {
      "type": "number",
      "title": "集中の長さ（分）",
      "description": "1 回の集中の長さ",
      "default": 25,
      "min": 1
    },
    "breakMinutes": {
      "type": "number",
      "title": "休憩の長さ（分）",
      "description": "集中が終わった後の休憩の長さ",
      "default": 5,
      "min": 1
    }
  }
}
